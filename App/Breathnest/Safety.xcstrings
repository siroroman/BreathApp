{
  "sourceLanguage" : "en",
  "strings" : {
    "safety.dizzy" : {
      "comment" : "Safety note, first line. Shown with every Exercise. Needs a reviewed translation before it is translated.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stop and breathe normally if you feel dizzy, lightheaded or faint."
          }
        }
      }
    },
    "safety.doctor" : {
      "comment" : "Safety note, second line. Needs a reviewed translation before it is translated.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ask a doctor first if you are pregnant or have a heart or breathing condition, glaucoma, seizures or a psychiatric condition."
          }
        }
      }
    },
    "safety.hold" : {
      "comment" : "Extra Safety note line, shown only with box breathing and 4-7-8, which have long holds. Needs a reviewed translation before it is translated.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If a hold feels too long, don't force it: stop and breathe normally."
          }
        }
      }
    },
    "safety.notAdvice" : {
      "comment" : "Safety note, last line. Needs a reviewed translation before it is translated.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This is not medical advice."
          }
        }
      }
    },
    "safety.places" : {
      "comment" : "Safety note, third line. Needs a reviewed translation before it is translated.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do not practise while driving, operating machinery, or in or near water."
