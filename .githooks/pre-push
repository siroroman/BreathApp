#!/usr/bin/env bash
# Enabled with: make setup (git config core.hooksPath .githooks)
# Refuses a push to main or master (docs/agents/git.md), then runs make lint and the Kit tests before anything leaves the machine:
# no simulator (docs/agents/commands.md). make lint covers docs-only and script-only branches too (check-docs.sh and others),
# and a branch is pushed before its pull request is opened, so a lint error cannot reach an open PR.
# Git feeds one "<local ref> <local sha> <remote ref> <remote sha>" line per ref on stdin.
set -euo pipefail

zero=0000000000000000000000000000000000000000
push=0
while read -r _ local_sha remote_ref _; do
  case "$remote_ref" in
    refs/heads/main | refs/heads/master)
      cat >&2 <<EOF
pre-push: refusing to push to '${remote_ref#refs/heads/}'. main only changes through a pull request.
Push a branch and open a pull request:
  git push -u origin <type>/<issue>-<slug>
Branch names and the flow: docs/agents/git.md. Do not use --no-verify.
EOF
      exit 1
      ;;
  esac
  [[ "$local_sha" == "$zero" ]] || push=1 # a delete pushes no commits
done
[[ $push -eq 1 ]] || exit 0

cd "$(git rev-parse --show-toplevel)"
make lint || { echo "pre-push: make lint failed, nothing was pushed. Run make format, fix what is left, read the last line (0/N files require formatting.), do not use --no-verify." >&2; exit 1; }
make test-kit || { echo "pre-push: make test-kit failed, nothing was pushed. Fix the test, do not use --no-verify." >&2; exit 1; }
