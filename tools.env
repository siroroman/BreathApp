# Tool versions of the repo, the one place they are written. Read by scripts/check-tools.sh (make lint),
# scripts/install-tools.sh (make setup, CI) and the CI workflow. Plain KEY=value, no spaces around `=`.
# Bump a pin in its own pull request: swiftformat and swiftlint format and lint differently from one version to the
# next, so a bump can fail make lint on files nobody touched. Run make format after it. Details: docs/agents/commands.md (Tools)

# Pinned: make lint fails when the installed version differs. Brew cannot install an old version, so these two are
# installed by scripts/install-tools.sh into .tools/bin, not by the Brewfile.
SWIFTFORMAT_VERSION=0.51.13
SWIFTLINT_VERSION=0.57.0

# Recorded: the versions the repo was last run with. The Brewfile installs the current ones, a difference is only a warning.
XCODEGEN_VERSION=2.44.1
GITLEAKS_VERSION=8.30.1
